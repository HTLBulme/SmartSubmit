// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  //output:@prisma/client
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int             @id @default(autoincrement())
  firstName       String          @db.VarChar(255)
  lastName        String          @db.VarChar(255)
  email           String          @unique @db.VarChar(255)
  passwordHash    String?         @db.VarChar(255)
  provider        String?         @db.VarChar(50)
  oauthId         String?         @db.VarChar(255)
  createdAt       DateTime        @default(now())
  active          Boolean         @default(true)

  userRoles       UserRole[]
  userClasses     UserClass[]
  userSubjects    UserSubject[]

  assignmentsCreated  Assignment[]    @relation("TeacherAssignments")
  submissions         Submission[]     @relation("StudentSubmissions")
}

model UserRole {
  id          Int      @id @default(autoincrement())
  userId      Int
  roleId      Int

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, roleId])
  @@map("User_Role")
}

model Role {
  id              Int             @id @default(autoincrement())
  name            String          @unique @db.VarChar(255)
  description     String?         @db.Text
  userRoles       UserRole[]
}



model Class {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(50)
  year       Int       
  userClasses UserClass[]
  assignments Assignment[] //Assignments given to the class, not to individual students
  
  @@unique([name, year])
}

model UserClass {
  id          Int      @id @default(autoincrement())
  userId      Int
  classId     Int

  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, classId]) 
  @@map("User_Class")
}

model Subject {
  id      Int    @id @default(autoincrement())
  name    String @db.VarChar(255)
  code    String @unique @db.VarChar(255)

  userSubjects UserSubject[]
  assignments  Assignment[]
}

model UserSubject {
  id          Int @id @default(autoincrement())
  userId      Int
  subjectId   Int

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, subjectId])
  @@map("User_Subject")
}

model Assignment {
  id                  Int       @id @default(autoincrement())
  title               String    @db.VarChar(255)
  description         String    @db.Text
  link                String?   @db.VarChar(1024) // URL for external resources related to the assignment
  attachments         String?   @db.Text // JSON array storing attachment paths metadata
  dueDate             DateTime  
  archived            Boolean   @default(false)
  classId             Int
  subjectId           Int
  teacherId           Int
  createdAt           DateTime  @default(now())
  
  class               Class     @relation(fields: [classId], references: [id], onDelete: Cascade) // Students graduate -> class is deleted -> all assignments are deleted
  subject             Subject   @relation(fields: [subjectId], references: [id])
  teacher             User      @relation("TeacherAssignments", fields: [teacherId], references: [id])
  submissions         Submission[]
  
  @@index([classId, dueDate])
  @@index([teacherId])
}

model Submission {
  id                  Int       @id @default(autoincrement())
  assignmentId        Int
  studentId           Int
  files               String?   @db.Text  // JSON string of file metadata array (originalName, storedName, mimeType, size, path)
  text                String?   @db.Text  // Free text submission
  submittedAt         DateTime  @default(now())
  grade               Int?   // Grade (0-100)
  feedback            String?   @db.Text
  
  assignment          Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student             User       @relation("StudentSubmissions", fields: [studentId], references: [id])
  
  @@unique([assignmentId, studentId])
  @@index([studentId])
}