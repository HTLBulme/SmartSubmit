# Copy these placeholders to backend/.env and fill them locally.
# Never commit backend/.env or a real Gmail App Password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# Teacher LDAP login. Keep disabled until a real Teacher acceptance test passes.
LDAP_TEACHER_LOGIN_ENABLED=false
LDAP_HOST=172.16.90.249
LDAP_PORT=389
# LDAP_URL overrides LDAP_HOST/LDAP_PORT when set.
LDAP_URL=
LDAP_TEACHER_BASE_DN=ou=lehrer,ou=people,dc=bin,dc=at
LDAP_LOGIN_ATTRIBUTE=uid
# anonymous | service
LDAP_BIND_MODE=anonymous
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_CONNECT_TIMEOUT_MS=5000
LDAP_OPERATION_TIMEOUT_MS=8000
# Must be at least 2 so duplicate identities can be detected.
LDAP_SEARCH_SIZE_LIMIT=2
# Explicit opt-in: only an existing local Teacher with the same verified LDAP mail may be linked.
LDAP_LINK_EXISTING_TEACHER_BY_EMAIL=false
