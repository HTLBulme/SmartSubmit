# Copy these placeholders to backend/.env and fill them locally.
# Never commit backend/.env or real credentials.

# Required local database and token configuration.
DATABASE_URL=
JWT_SECRET=

# Optional server and frontend callback configuration.
PORT=
HOST=
FRONTEND_URL=
# Set only when the app is behind a known proxy (explicit IP/CIDR or loopback/linklocal/uniquelocal).
TRUST_PROXY=

# Optional Google OAuth. GOOGLE_CALLBACK_URL takes precedence over GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GOOGLE_REDIRECT_URI=

# Optional SMTP email delivery.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
# Optional alternative to EMAIL_PASSWORD.
EMAIL_PASS=
EMAIL_FROM=

# Teacher LDAP login. Keep disabled until a real Teacher acceptance test passes.
LDAP_TEACHER_LOGIN_ENABLED=false
LDAP_HOST=172.16.90.249
LDAP_PORT=389
# LDAP_URL overrides LDAP_HOST/LDAP_PORT when set.
LDAP_URL=
LDAP_TEACHER_BASE_DN=ou=lehrer,ou=people,dc=bin,dc=at
LDAP_LOGIN_ATTRIBUTE=uid
# anonymous | service
LDAP_BIND_MODE=anonymous
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_CONNECT_TIMEOUT_MS=5000
LDAP_OPERATION_TIMEOUT_MS=8000
# Must be at least 2 so duplicate identities can be detected.
LDAP_SEARCH_SIZE_LIMIT=2
# Explicit opt-in: only an existing local Teacher with the same verified LDAP mail may be linked.
LDAP_LINK_EXISTING_TEACHER_BY_EMAIL=false
